---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site } from '../config';
import { getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const legalHref = getLocalizedPath('/legal', lang);
---

<footer class="footer">
  <span>{site.name}</span>
  <span class="footer__group">
    <a href={site.github} target="_blank" rel="noopener">GitHub</a>
    <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    <a href={`mailto:${site.email}`}>{site.email}</a>
  </span>
  <span class="footer__group footer__group--meta">
    <a href={legalHref}>{t('footer.legal')}</a>
    <a href="https://astro.build" target="_blank" rel="noopener">{t('footer.built')}</a>
  </span>
</footer>
