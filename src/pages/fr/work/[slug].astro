---
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ProjectDetail from '../../../components/ProjectDetail.astro';
import { getLocalizedPaths, getProjectHref } from '../../../content/helpers';
import { site } from '../../../config';

export const getStaticPaths = () => getLocalizedPaths('projects', 'fr');

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const markdownHref = `${getProjectHref(entry, 'fr')}.md`;
---

<SiteLayout
  lang="fr"
  title={`${entry.data.title} | ${site.name}`}
  description={entry.data.desc}
  ogType="article"
  markdownHref={markdownHref}
  structuredData={{ type: 'project', entry }}
>
  <ProjectDetail entry={entry} lang="fr" />
</SiteLayout>
