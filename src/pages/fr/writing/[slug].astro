---
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PostDetail from '../../../components/PostDetail.astro';
import { getLocalizedPaths, getWritingHref } from '../../../content/helpers';
import { site } from '../../../config';

export const getStaticPaths = () => getLocalizedPaths('writing', 'fr');

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const markdownHref = `${getWritingHref(entry, 'fr')}.md`;
---

<SiteLayout
  lang="fr"
  title={`${entry.data.title} | ${site.name}`}
  description={entry.data.dek}
  ogType="article"
  markdownHref={markdownHref}
  structuredData={{ type: 'post', entry }}
>
  <PostDetail entry={entry} lang="fr" />
</SiteLayout>
