---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout lang="en" title="404 | Bruno Seilliebert" description="Page not found">
  <section class="hero" aria-labelledby="nf-title">
    <div class="hero__content">
      <h1 class="hero__name" id="nf-title">404</h1>

      <h2 class="hero__title">
        <span data-en="Page not found" data-fr="Page introuvable">Page not found</span>
      </h2>

      <a class="detail__back" href="/" data-en-href="/" data-fr-href="/fr/">
        <span data-en="← back home" data-fr="← retour à l'accueil">← back home</span>
      </a>
    </div>
  </section>
</SiteLayout>

<script is:inline>
  (function () {
    if (!window.location.pathname.startsWith('/fr')) return;
    document.documentElement.lang = 'fr';
    document.querySelectorAll('[data-fr]').forEach(function (el) {
      el.textContent = el.getAttribute('data-fr');
    });
    document.querySelectorAll('[data-fr-href]').forEach(function (el) {
      el.setAttribute('href', el.getAttribute('data-fr-href'));
    });
  })();
</script>
