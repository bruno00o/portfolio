---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { stackRows as rows } from '../content/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

---

<section class="stack" id="stack" aria-labelledby="stack-label">
  <div class="stack__head">
    <span class="stack__label" id="stack-label">{t('stack.label')}</span>
  </div>

  <div class="stack__card">
    {
      rows.map((row) => (
        <div class="stack-row">
          <span class="stack-row__k">{t(row.labelKey)}</span>
          <span class="stack-row__v">
            {row.items.map((it, i) => (
              <>
                {i > 0 && <span class="sep">/</span>}
                <span>{it}</span>
              </>
            ))}
          </span>
        </div>
      ))
    }
  </div>
</section>
