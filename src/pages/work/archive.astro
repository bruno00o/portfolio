---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectArchive from '../../components/ProjectArchive.astro';
import { useTranslations } from '../../i18n/utils';
import { site } from '../../config';

const t = useTranslations('en');
---

<SiteLayout
  lang="en"
  title={`${t('archive.title')} | ${site.name}`}
  description={t('archive.dek')}
  markdownHref="/work/archive.md"
>
  <ProjectArchive lang="en" />
</SiteLayout>
