---
import { useTranslations } from '../i18n/utils';
import type { Lang, TranslationKey } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

type XpItem = {
  dates: string;
  roleKey: TranslationKey;
  subKey: TranslationKey;
  tagKey?: TranslationKey;
};

const work: XpItem[] = [
  { dates: `2025 → ${t('common.present')}`, roleKey: 'xp.w1.role', subKey: 'xp.w1.sub', tagKey: 'xp.w1.tag' },
  { dates: '2023 → 2025', roleKey: 'xp.w2.role', subKey: 'xp.w2.sub', tagKey: 'xp.w2.tag' },
  { dates: '2022 → 2023', roleKey: 'xp.w3.role', subKey: 'xp.w3.sub', tagKey: 'xp.w3.tag' },
];

const education: XpItem[] = [
  { dates: '2023 → 2025', roleKey: 'xp.e1.role', subKey: 'xp.e1.sub', tagKey: 'xp.e1.tag' },
  { dates: '2020 → 2023', roleKey: 'xp.e2.role', subKey: 'xp.e2.sub' },
];

type Column = { label: string; items: XpItem[]; anchor: string };

const columns: Column[] = [
  { label: t('xp.label'), items: work, anchor: 'experience' },
  { label: t('xp.edu_label'), items: education, anchor: 'education' },
];
---

<section class="xp" id="experience">
  {
    columns.map((col) => (
      <div class="xp__col" aria-labelledby={`xp-label-${col.anchor}`}>
        <div class="xp__head">
          <span class="xp__label" id={`xp-label-${col.anchor}`}>{col.label}</span>
        </div>

        <div class="xp__list">
          {col.items.map((it) => (
            <div class="xp-item">
              <div class="xp-item__main">
                <span class="xp-item__role">{t(it.roleKey)}</span>
                <span class="xp-item__sub">
                  {t(it.subKey)} {it.tagKey && <em>{t(it.tagKey)}</em>}
                </span>
              </div>
              <span class="xp-item__dates">{it.dates}</span>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</section>
