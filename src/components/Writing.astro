---
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { formatPostDate, getWritingHref } from '../content/helpers';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (
  await getCollection('writing', (entry) => entry.data.locale === lang)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

---

<section class="writing" id="writing" aria-labelledby="writing-label">
  <div class="writing__head">
    <span class="writing__label" id="writing-label">{t('writing.label')}</span>
  </div>

  <div class="writing__list">
    {
      posts.map((p) => (
        <a class="post" href={getWritingHref(p, lang)}>
          <span class="post__date">{formatPostDate(p.data.date, lang)}</span>
          <div class="post__main">
            <span class="post__title">{p.data.title}</span>
            <span class="post__dek">{p.data.dek}</span>
          </div>
          <span class="post__tags">
            {p.data.draft ? (
              <span class="post__tag post__tag--draft">{t('writing.draft')}</span>
            ) : (
              p.data.tags.map((tag) => <span class="post__tag">{tag}</span>)
            )}
          </span>
        </a>
      ))
    }
  </div>
</section>
