---
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostDetail from '../../components/PostDetail.astro';
import { getLocalizedPaths, getWritingHref } from '../../content/helpers';
import { site } from '../../config';

export const getStaticPaths = () => getLocalizedPaths('writing', 'en');

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const markdownHref = `${getWritingHref(entry, 'en')}.md`;
---

<SiteLayout
  lang="en"
  title={`${entry.data.title} | ${site.name}`}
  description={entry.data.dek}
  ogType="article"
  markdownHref={markdownHref}
>
  <PostDetail entry={entry} lang="en" />
</SiteLayout>
