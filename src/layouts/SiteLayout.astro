---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';
import type { StructuredData } from '../seo';
import '../styles/detail.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  markdownHref?: string;
  structuredData?: StructuredData;
}

const { lang, title, description, ogType, ogImage, markdownHref, structuredData } = Astro.props as Props;
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  ogType={ogType}
  ogImage={ogImage}
  markdownHref={markdownHref}
  structuredData={structuredData}
>
  <div class="app">
    <Nav lang={lang} />
    <main class="page">
      <slot />
    </main>
    <Footer lang={lang} />
  </div>
</BaseLayout>
